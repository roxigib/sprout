rules_version = '2';
// Paste into Firebase console → Firestore Database → Rules, then Publish.
// Only members of a family can read or write its log. People can join a family
// only if a member invited their (Google-verified) email address.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    function invited(data) {
      return signedIn() && request.auth.token.email_verified == true && myEmail() in data.invites;
    }
    function isMember(familyId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.members;
    }

    match /families/{familyId} {
      allow read: if signedIn() && (request.auth.uid in resource.data.members || invited(resource.data));

      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.invites is list
        && request.resource.data.memberInfo is map;

      allow update: if signedIn() && (
        // Members can invite, cancel invites and update member info.
        (request.auth.uid in resource.data.members
          && request.resource.data.owner == resource.data.owner
          && request.resource.data.members.hasAll(resource.data.members))
        // An invited person can add only themselves.
        || (invited(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'invites', 'memberInfo'])
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.auth.uid in request.resource.data.members
          && request.resource.data.memberInfo.diff(resource.data.memberInfo).affectedKeys().hasOnly([request.auth.uid]))
      );

      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      match /{document=**} {
        allow read, write: if isMember(familyId);
      }
    }
  }
}
